---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Modelado from '../components/Modelado.astro';
import Normalizacion from '../components/Normalizacion.astro';
import Sql from '../components/Sql.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import Footer from '../components/Footer.astro';
import { site } from '../../data/site';

const projects = site.featuredProjects;
---

<Layout title={site.meta.title} description={site.meta.description}>
  <div id="about" data-tab-panel>
    <About />
    <Experience />
  </div>

  <div id="modelado" data-tab-panel hidden>
    <Modelado />
  </div>

  <div id="normalizacion" data-tab-panel hidden>
    <Normalizacion />
  </div>

  <div id="sql" data-tab-panel hidden>
    <Sql />
  </div>

  <div id="proyecto" data-tab-panel hidden>
    <FeaturedProjects projects={projects} compact />
  </div>

  <Footer />
</Layout>