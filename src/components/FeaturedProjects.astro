---
import type { FeaturedProject } from '../../data/site';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: readonly FeaturedProject[];
  compact?: boolean;
}

const { projects, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section
  id="proyecto-content"
  class="mb-20 scroll-mt-24 lg:mb-28 lg:scroll-mt-8"
  aria-labelledby="proyecto-heading"
>
  <h2 id="proyecto-heading" class="section-heading">Proyecto</h2>
  <div class:list={[compact ? 'space-y-8' : 'space-y-20']}>
    {projects.length === 0 && (
      <p class="body-copy">Aún no hay proyectos agregados en esta sección.</p>
    )}
    {projects.map((project) => (
      <ProjectCard
        project={project}
        imageSrc={project.image ? `${base}${project.image}` : undefined}
        compact={compact}
      />
    ))}
  </div>
</section>