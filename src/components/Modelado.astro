---
import { site } from '@data/site';

const { title, paragraphs, imageSrc, imageAlt } = site.evidences.modelado;
---

<section
  id="modelado-content"
  class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
  aria-labelledby="modelado-heading"
>
  <h2 id="modelado-heading" class="section-heading">{title}</h2>
  <div class="reveal-content mt-8 space-y-8">
    <!-- Párrafos arriba -->
    <div class="body-copy">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <!-- Alt (descripción) en medio -->
    {imageAlt && <p class="text-sm text-gray-600 italic">{imageAlt}</p>}

    <!-- Imagen abajo -->
    {imageSrc && (
      <img src={imageSrc} alt={imageAlt} class="rounded-lg shadow-md w-full" />
    )}
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>