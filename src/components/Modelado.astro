---
import { site } from '@data/site';

const { title, paragraphs, linkText, linkUrl } = site.evidences.modelado;
---

<section
  id="modelado-content"
  class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
  aria-labelledby="modelado-heading"
>
  <h2 id="modelado-heading" class="section-heading">{title}</h2>

  <div class="reveal-content mt-8 space-y-6">
    <div class="body-copy">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <a
      href={linkUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block text-blue-600 underline hover:text-blue-800"
    >
      {linkText}
    </a>
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>