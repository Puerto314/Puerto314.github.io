---
import { site } from '@data/site';

const section = site.evidences.normalizacion;
const links = section.links ?? [];
---

<section
  id="normalizacion-content"
  class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
  aria-labelledby="normalizacion-heading"
>
  <h2 id="normalizacion-heading" class="section-heading">{section.title}</h2>

  <div class="reveal-content mt-8 space-y-6">
    <div class="body-copy">
      {section.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    {links.length > 0 && (
      <div class="link-stack">
        {links.map((link) => (
          <div class="link-item">
            <h3 class="link-title">{link.title}</h3>
            <p class="link-description">{link.description}</p>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-blue-600 underline hover:text-blue-800"
            >
              {link.title}
            </a>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .link-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .link-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.35);
    border-radius: 0.75rem;
    padding: 1rem 1.1rem;
  }

  .link-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .link-description {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.6;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
