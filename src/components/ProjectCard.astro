---
import type { FeaturedProject } from '../../data/site';

interface Props {
  project: FeaturedProject;
  imageSrc?: string;
  compact?: boolean;
}

const { project, imageSrc: imageOverride, compact = false } = Astro.props;

const techCategories = project.techCategories;
const imageSrc = imageOverride ?? (project.image ? (project.image.startsWith('/') ? project.image : `/${project.image}`) : undefined);
---

<article class:list={['scroll-stat panel-card group', compact ? 'space-y-4 p-4' : 'space-y-6']}>
  <header>
    <h3 class:list={[compact ? 'text-lg' : 'text-2xl', 'font-semibold text-slate']}>
      {project.title}
    </h3>
    {project.period && <p class="mt-1 font-mono text-sm text-accent">{project.period}</p>}
  </header>

  {imageSrc && (
    <div class:list={['w-full overflow-hidden rounded-xl', compact ? 'max-w-xl' : 'max-w-3xl']}>
      <img
        src={imageSrc}
        alt={project.imageAlt ?? ''}
        class:list={['w-full object-cover', compact ? 'h-32' : 'h-56']}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class:list={[compact ? 'space-y-2' : 'space-y-4']}>
    <p class:list={['body-copy', compact && 'text-sm']}>{project.summary}</p>

    {project.solution && (
      <div>
        <dt class="text-xs uppercase tracking-wider text-accent">Solución</dt>
        <dd class:list={['mt-1.5 text-slate', compact && 'text-sm']}>{project.solution}</dd>
      </div>
    )}
    {project.impact && (
      <div>
        <dt class="text-xs uppercase tracking-wider text-accent">Impacto</dt>
        <dd class:list={['mt-1.5 text-slate', compact && 'text-sm']}>{project.impact}</dd>
      </div>
    )}
  </div>

  <div>
    <dt class="mb-3 text-xs uppercase tracking-wider text-accent">Tecnologías / Herramientas</dt>
    <div class:list={['grid grid-cols-1 gap-4', !compact && 'sm:grid-cols-2']}>
      {techCategories.map((techCat) => (
        <div>
          <h4 class="mb-2 text-xs uppercase tracking-wider text-slate-lightest">
            {techCat.category}
          </h4>
          <ul class="space-y-1">
            {techCat.items.map((item) => (
              <li class="text-sm text-slate-light">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</article>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); 
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  
  document.addEventListener('astro:after-swap', revealCards);
</script>