---
/**
 * CursorEyes.astro
 * Par de ojos fijos en la esquina inferior izquierda que siguen el cursor.
 *
 * Uso: importa este componente en tu Layout principal (por ejemplo
 * src/layouts/Layout.astro) y colócalo justo antes de cerrar </body>:
 *
 *   import CursorEyes from '../components/CursorEyes.astro';
 *   ...
 *   <CursorEyes />
 *   </body>
 */
---

<div class="cursor-eyes" aria-hidden="true">
  <svg viewBox="0 0 120 60" width="90" height="45">
    <ellipse cx="30" cy="30" rx="26" ry="26" class="eye-white" />
    <ellipse cx="90" cy="30" rx="26" ry="26" class="eye-white" />
    <circle id="pupil-left" cx="30" cy="30" r="10" class="pupil" />
    <circle id="pupil-right" cx="90" cy="30" r="10" class="pupil" />
  </svg>
</div>

<style>
  .cursor-eyes {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 50;
    pointer-events: none;
    user-select: none;
  }

  .eye-white {
    fill: #ffffff;
    stroke: #111111;
    stroke-width: 2;
  }

  .pupil {
    fill: #111111;
  }

  @media (prefers-color-scheme: dark) {
    .eye-white {
      fill: #1f1f1f;
      stroke: #ffffff;
    }
    .pupil {
      fill: #ffffff;
    }
  }
</style>

<script>
  function initCursorEyes() {
    const pupilLeft = document.getElementById('pupil-left');
    const pupilRight = document.getElementById('pupil-right');
    if (!pupilLeft || !pupilRight) return;

    const eyeCenters = [
      { x: 30, y: 30 },
      { x: 90, y: 30 },
    ];
    const maxOffset = 8; // qué tanto se mueve la pupila dentro del ojo

    function updatePupils(mouseX: number, mouseY: number) {
      const svg = pupilLeft.closest('svg');
      if (!svg) return;
      const rect = svg.getBoundingClientRect();

      [pupilLeft, pupilRight].forEach((pupil, i) => {
        const center = eyeCenters[i];
        const eyeScreenX = rect.left + (center.x / 120) * rect.width;
        const eyeScreenY = rect.top + (center.y / 60) * rect.height;

        const dx = mouseX - eyeScreenX;
        const dy = mouseY - eyeScreenY;
        const angle = Math.atan2(dy, dx);
        const distance = Math.min(maxOffset, Math.hypot(dx, dy) / 10);

        const offsetX = Math.cos(angle) * distance;
        const offsetY = Math.sin(angle) * distance;

        pupil.setAttribute('cx', String(center.x + offsetX));
        pupil.setAttribute('cy', String(center.y + offsetY));
      });
    }

    window.addEventListener('mousemove', (e) => {
      updatePupils(e.clientX, e.clientY);
    });
  }

  initCursorEyes();
  document.addEventListener('astro:page-load', initCursorEyes);
</script>