---
import { navLinks, presentationVideo } from '@data/nav';
import SiteIntro from './SiteIntro.astro';
---


<aside class="relative hidden shrink-0 lg:block lg:w-[42%]">
  <div class="reveal-content sticky top-0 flex h-screen max-h-screen flex-col justify-between items-center overflow-y-auto pt-22 px-12 text-center">
    <div class="space-y-12">
      <SiteIntro variant="sidebar" />

      
        href={presentationVideo.href}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-accent/60 px-5 py-2 text-sm font-semibold text-accent transition hover:bg-accent/10"
      >
        {presentationVideo.label}
      </a>

      <nav aria-label="Principal">
        <ul class="flex flex-col items-center gap-4">
          {
            navLinks.map((link, index) => (
              <li>
                
                  href={`${import.meta.env.BASE_URL}${link.href}`}
                  class="nav-link"
                  data-section-link
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</aside>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initTabs() {
    const links = Array.from(document.querySelectorAll('[data-section-link]'));
    const panels = Array.from(document.querySelectorAll('[data-tab-panel]'));

    if (!links.length || !panels.length) return;

    const activate = (id) => {
      panels.forEach((panel) => {
        panel.hidden = panel.id !== id;
      });

      links.forEach((link) => {
        const targetId = (link.getAttribute('href') || '').split('#')[1] || '';
        const isActive = targetId === id;
        link.classList.toggle('nav-link-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const targetId = (link.getAttribute('href') || '').split('#')[1] || '';
        if (!targetId) return;
        event.preventDefault();
        activate(targetId);
        history.replaceState(null, '', `#${targetId}`);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    const hash = window.location.hash.replace('#', '');
    const initialId = panels.some((panel) => panel.id === hash) ? hash : panels[0].id;
    activate(initialId);
  }

  initTabs();
  document.addEventListener('astro:page-load', initTabs);
</script>